# ─── Django ───────────────────────────────────────────
DJANGO_SECRET_KEY=replace-with-generated-secret-key
DJANGO_DEBUG=False
ALLOWED_HOSTS=tour.aprayogshala.com.np,localhost,127.0.0.1,backend

# ─── Database ─────────────────────────────────────────
POSTGRES_DB=tour_db
POSTGRES_USER=tour
POSTGRES_PASSWORD=replace-with-generated-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ─── CORS / CSRF ──────────────────────────────────────
FRONTEND_URL=https://tour.aprayogshala.com.np
CORS_ALLOWED_ORIGINS=https://tour.aprayogshala.com.np
CSRF_TRUSTED_ORIGINS=https://tour.aprayogshala.com.np

# ─── Redis ────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Payment ──────────────────────────────────────────
ESEWA_MERCHANT_CODE=
KHALTI_MERCHANT_KEY=
PAYMENT_DEV_MODE=False

# ─── Email ────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.provider.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=TourNepal <noreply@tour.aprayogshala.com.np>
