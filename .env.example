# ─── Django ───────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=False

# ─── Database ─────────────────────────────────────────
POSTGRES_DB=tour_db
POSTGRES_USER=tour
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ─── CORS ─────────────────────────────────────────────
FRONTEND_URL=https://your-domain.com

# ─── Email (SMTP) ─────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=TourNepal <noreply@your-domain.com>

# ─── Payment Gateways ─────────────────────────────────
ESEWA_MERCHANT_CODE=your-esewa-code
KHALTI_MERCHANT_KEY=your-khalti-key
PAYMENT_DEV_MODE=False
